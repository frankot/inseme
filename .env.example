# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Neon dashboard → project → Connection string → "Pooled connection".
# Use a separate Neon branch for dev and for production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/insieme?sslmode=require"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Only needed when the deployment URL can't be inferred (custom domain on Vercel).
# AUTH_URL="https://insieme.pl"

# ── Cloudflare R2 (phase B2 — media library) ────────────────────────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="insieme-media"
# R2_PUBLIC_URL="https://media.insieme.pl"
